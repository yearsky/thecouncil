# API key DeepSeek (bayar per pemakaian). Salin file ini menjadi .env lalu isi.
DEEPSEEK_API_KEY=

# Opsional untuk `council ui`: kalau diisi, UI lokal meminta password.
# Di Vercel, isi juga COUNCIL_PASSWORD (wajib), COUNCIL_SECRET, COUNCIL_API_TOKEN, COUNCIL_DAILY_RUNS
# sebagai Environment Variables project (lihat README).
COUNCIL_PASSWORD=
